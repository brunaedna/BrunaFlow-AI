GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite
BRUNAFLOW_AI_PROVIDER_ORDER=groq,gemini

# Credenciais OAuth do aplicativo Google. Cada visitante conecta a própria conta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_ENCRYPTION_KEY=

# Opcionais: remetente de serviço usado apenas por webhooks sem sessão de navegador.
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=

# Segredo enviado no cabeçalho x-brunaflow-secret do webhook.
BRUNAFLOW_WEBHOOK_SECRET=
